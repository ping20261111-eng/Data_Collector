import os
import sys
import re
import time
import signal
import subprocess
import logging
import yaml
import shutil
from pathlib import Path
from typing import Optional, List, Tuple, Any

# ============ 日志 ============
def setup_logger(name: str = "data_collector", log_file: Path = None) -> logging.Logger:
    logger = logging.getLogger(name)
    logger.setLevel(logging.DEBUG)
    formatter = logging.Formatter("%(asctime)s - %(name)s - %(levelname)s - %(message)s")
    console = logging.StreamHandler(sys.stdout)
    console.setLevel(logging.INFO)
    console.setFormatter(formatter)
    logger.addHandler(console)
    if log_file:
        log_file.parent.mkdir(parents=True, exist_ok=True)
        fh = logging.FileHandler(log_file, encoding="utf-8")
        fh.setLevel(logging.DEBUG)
        fh.setFormatter(formatter)
        logger.addHandler(fh)
    return logger

logger = setup_logger()

# ============ YAML 工具 ============
def load_yaml(path: Path) -> dict:
    with open(path, 'r', encoding='utf-8') as f:
        return yaml.safe_load(f)

def save_yaml(path: Path, data: dict) -> None:
    with open(path, 'w', encoding='utf-8') as f:
        yaml.dump(data, f, allow_unicode=True, default_flow_style=False, sort_keys=False)

# ============ 子进程工具 ============
def check_command_exists(cmd: str) -> bool:
    return shutil.which(cmd) is not None

def run_in_terminal(command: str, terminal: str = "gnome-terminal") -> subprocess.Popen:
    """在新终端中执行命令，自动选择可用终端（优先 xterm）"""
    if "DISPLAY" not in os.environ:
        logger.warning("DISPLAY 未设置，可能无法启动图形终端")

    if check_command_exists("xterm"):
        cmd = ["xterm", "-e", f"bash -c '{command}; exec bash'"]
        try:
            return subprocess.Popen(cmd)
        except Exception as e:
            logger.warning(f"xterm 启动失败: {e}")

    if check_command_exists("gnome-terminal"):
        cmd = ["gnome-terminal", "--disable-factory", "--", "bash", "-c", f"{command}; exec bash"]
        try:
            return subprocess.Popen(cmd)
        except Exception as e:
            logger.warning(f"gnome-terminal (disable-factory) 启动失败: {e}")

    if check_command_exists(terminal):
        cmd = [terminal, "--", "bash", "-c", f"{command}; exec bash"]
        try:
            return subprocess.Popen(cmd)
        except Exception as e:
            raise RuntimeError(f"终端启动失败: {e}")

    raise RuntimeError("没有可用的终端模拟器 (xterm, gnome-terminal)")

def run_background(command: str, cwd: Path) -> subprocess.Popen:
    """后台运行命令（无终端）"""
    return subprocess.Popen(
        ["bash", "-c", command],
        cwd=str(cwd),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        stdin=subprocess.DEVNULL,
    )

def run_with_env(cmd_list: List[str], env_add: dict = None, cwd: Path = None) -> subprocess.Popen:
    env = os.environ.copy()
    if env_add:
        env.update(env_add)
    return subprocess.Popen(
        cmd_list,
        env=env,
        cwd=str(cwd),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        start_new_session=True,  # 创建独立进程组，便于终止整个进程树
    )

def terminate(proc: subprocess.Popen) -> None:
    """终止进程及其子进程，发送 SIGINT (Ctrl+C) 模拟优雅退出"""
    if proc and proc.poll() is None:
        try:
            # 尝试向整个进程组发送 SIGINT
            pgid = os.getpgid(proc.pid)
            os.killpg(pgid, signal.SIGINT)
            proc.wait(timeout=3)
        except (ProcessLookupError, OSError) as e:
            logger.debug(f"无法发送进程组信号，回退到单个进程: {e}")
            proc.send_signal(signal.SIGINT)
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                proc.kill()
        except subprocess.TimeoutExpired:
            proc.kill()

# ============ 配置管理器 ============
class ConfigManager:
    def __init__(self, config_path: Path):
        self.app_config = load_yaml(config_path)
        self.workspace = Path(self.app_config["workspace_root"]).expanduser()
        self.teleop_config_path = self.workspace / self.app_config["teleop_config_path"]

    def get_teleop_config(self) -> dict:
        return load_yaml(self.teleop_config_path)

    def save_teleop_config(self, data: dict) -> None:
        top_order = ['teleop', 'calibrations', 'trackers']
        ordered_data = {}
        for key in top_order:
            if key in data:
                ordered_data[key] = data[key]

        if 'calibrations' in ordered_data:
            calib_ordered = {}
            inner_order = ['tracker_index', 'shoulder_width', 'arm_length', 'elbow_length']
            for user, params in ordered_data['calibrations'].items():
                user_ordered = {}
                for k in inner_order:
                    if k in params:
                        user_ordered[k] = params[k]
                for k, v in params.items():
                    if k not in user_ordered:
                        user_ordered[k] = v
                calib_ordered[user] = user_ordered
            ordered_data['calibrations'] = calib_ordered

        save_yaml(self.teleop_config_path, ordered_data)

    def get_user_calibration(self, username: str) -> Optional[dict]:
        cfg = self.get_teleop_config()
        return cfg.get("calibrations", {}).get(username)

    def set_teleop_calibration_user(self, username: str) -> bool:
        cfg = self.get_teleop_config()
        if username not in cfg.get("calibrations", {}):
            return False
        cfg["teleop"]["calibration"] = username
        self.save_teleop_config(cfg)
        return True

    def add_calibration_user(self, username: str, tracker: str, sw: float, al: float, elbow: float = 0.35):
        cfg = self.get_teleop_config()
        cfg.setdefault("calibrations", {})[username] = {
            "tracker_index": tracker,
            "shoulder_width": sw,
            "arm_length": al,
            "elbow_length": elbow
        }
        cfg["teleop"]["calibration"] = username
        self.save_teleop_config(cfg)

    def get_script_path(self, key: str) -> Path:
        return self.workspace / self.app_config[key]

    def get_teleop_script_path(self) -> Path:
        return self.workspace / self.app_config["run_teleop_script"]

    def get_terminal(self) -> str:
        return self.app_config.get("terminal_command", "gnome-terminal")

    def check_workspace(self) -> bool:
        return self.workspace.exists()

# ============ 启动器 ============
class Launcher:
    def __init__(self, config: ConfigManager):
        self.config = config

    def launch_run_nodes(self, options: List[str]) -> subprocess.Popen:
        """启动主程序（在新终端中运行）"""
        if not self.config.check_workspace():
            raise FileNotFoundError(f"工作空间不存在: {self.config.workspace}")
        script = self.config.get_script_path("run_nodes_script")
        if not script.exists():
            raise FileNotFoundError(f"脚本不存在: {script}")
        if not os.access(script, os.X_OK):
            raise PermissionError(f"脚本没有执行权限: {script}")

        setup_script = self.config.workspace / "install/setup.bash"
        if not setup_script.exists():
            raise FileNotFoundError(f"setup.bash 不存在: {setup_script}")

        cmd = (
            f"cd {self.config.workspace} && "
            f"source install/setup.bash && "
            f"bash {script} " + " ".join(options) + " ; "
            f"echo '=== run_nodes.sh 已退出，退出码: $? ===' ; "
            f"read -p '按 Enter 键关闭窗口...'"
        )
        terminal = self.config.get_terminal()
        logger.info(f"在新终端启动主程序: {cmd}")
        return run_in_terminal(cmd, terminal)

    def launch_teleop(self) -> subprocess.Popen:
        """启动遥操作脚本（后台运行，无终端）"""
        if not self.config.check_workspace():
            raise FileNotFoundError(f"工作空间不存在: {self.config.workspace}")
        script = self.config.get_teleop_script_path()
        if not script.exists():
            raise FileNotFoundError(f"遥操作脚本不存在: {script}")
        if not os.access(script, os.X_OK):
            raise PermissionError(f"脚本没有执行权限: {script}")

        setup_script = self.config.workspace / "install/setup.bash"
        if not setup_script.exists():
            raise FileNotFoundError(f"setup.bash 不存在: {setup_script}")

        cmd = (
            f"cd {self.config.workspace} && "
            f"source install/setup.bash && "
            f"bash {script}"
        )
        logger.info(f"后台启动遥操作: {cmd}")
        return run_background(cmd, self.config.workspace)

    def launch_record(self, script_type: str, name: str = "", desc: str = "") -> subprocess.Popen:
        """启动录制脚本（后台运行，无终端）"""
        if not self.config.check_workspace():
            raise FileNotFoundError(f"工作空间不存在: {self.config.workspace}")
        key = f"record_{script_type}_script"
        script = self.config.get_script_path(key)
        if not script.exists():
            raise FileNotFoundError(f"录制脚本不存在: {script}")
        if not os.access(script, os.X_OK):
            raise PermissionError(f"脚本没有执行权限: {script}")

        args = []
        if name: args.append(f"name={name}")
        if desc: args.append(f"desc={desc}")
        cmd = f"bash {script} " + " ".join(args)
        logger.info(f"后台启动录制 ({script_type}): {cmd}")
        return run_background(cmd, self.config.workspace)

    def launch_vr_bridge(self) -> subprocess.Popen:
        """启动 vr_bridge_node（后台，带进程组管理）"""
        if not self.config.check_workspace():
            raise FileNotFoundError(f"工作空间不存在: {self.config.workspace}")
        cmd = f"source {self.config.workspace}/install/setup.bash && ros2 run teleop vr_bridge_node"
        return run_with_env(["bash", "-c", cmd], cwd=self.config.workspace)

    def launch_calibration(self, username: str, tracker_number_str: str) -> subprocess.Popen:
        """启动 calibration_node，自动输入用户名和 tracker 编号（数字字符串）"""
        if not self.config.check_workspace():
            raise FileNotFoundError(f"工作空间不存在: {self.config.workspace}")
        cmd = f"source {self.config.workspace}/install/setup.bash && ros2 run teleop calibration_node"
        proc = subprocess.Popen(
            ["bash", "-c", cmd],
            cwd=str(self.config.workspace),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            start_new_session=True,
        )
        proc.stdin.write(f"{username}\n{tracker_number_str}\n")
        proc.stdin.flush()
        return proc

# ============ 遥操作管理器 ============
class TeleopManager:
    def __init__(self, config: ConfigManager, launcher: Launcher):
        self.config = config
        self.launcher = launcher

    def check_user(self, username: str) -> bool:
        return self.config.get_user_calibration(username) is not None

    def activate_user(self, username: str) -> bool:
        return self.config.set_teleop_calibration_user(username)

    def run_calibration(self, username: str, tracker_number: int, output_callback=None) -> Tuple[bool, Optional[str], Optional[float], Optional[float]]:
        tracker = f"tracker{tracker_number}"
        vr_proc = None
        cal_proc = None
        try:
            vr_proc = self.launcher.launch_vr_bridge()
            time.sleep(1)
            cal_proc = self.launcher.launch_calibration(username, str(tracker_number))
            sw, al = None, None
            calibration_done = False
            timeout = 120
            start = time.time()
            while time.time() - start < timeout:
                line = cal_proc.stdout.readline()
                if not line:
                    if cal_proc.poll() is not None:
                        if calibration_done:
                            break
                        else:
                            err = cal_proc.stderr.read()
                            return False, f"标定节点意外退出: {err}", None, None
                    break
                if output_callback:
                    output_callback(line.strip())
                logger.debug(f"calibration: {line.strip()}")
                if "标定完成" in line:
                    calibration_done = True
                    for _ in range(5):
                        nxt = cal_proc.stdout.readline()
                        if not nxt:
                            break
                        if output_callback:
                            output_callback(nxt.strip())
                        m = re.search(r"shoulder_width\s*=\s*([\d.]+)", nxt)
                        if m: sw = float(m.group(1))
                        m = re.search(r"arm_length\s*=\s*([\d.]+)", nxt)
                        if m: al = float(m.group(1))
                    break

            if sw is None or al is None:
                rest = cal_proc.stdout.read()
                if output_callback and rest:
                    output_callback(rest.strip())
                m = re.search(r"shoulder_width\s*=\s*([\d.]+)", rest)
                if m: sw = float(m.group(1))
                m = re.search(r"arm_length\s*=\s*([\d.]+)", rest)
                if m: al = float(m.group(1))
                if sw is None or al is None:
                    err = cal_proc.stderr.read()
                    return False, f"解析标定结果失败: {err}", None, None

            self.config.add_calibration_user(username, tracker, sw, al, 0.35)
            terminate(cal_proc)
            terminate(vr_proc)   # 这里会发送 SIGINT 给 vr_bridge_node 进程组
            return True, None, sw, al
        except Exception as e:
            logger.error(f"标定异常: {e}", exc_info=True)
            terminate(cal_proc)
            terminate(vr_proc)
            return False, str(e), None, None

    def launch_teleop(self) -> subprocess.Popen:
        return self.launcher.launch_teleop()

# ============ 录制管理器 ============
class RecorderManager:
    def __init__(self, config: ConfigManager, launcher: Launcher):
        self.config = config
        self.launcher = launcher
        self.current_proc: Optional[subprocess.Popen] = None

    def start(self, script_type: str, name: str = "", desc: str = "") -> bool:
        if self.current_proc and self.current_proc.poll() is None:
            logger.warning("录制已在进行中")
            return False
        try:
            self.current_proc = self.launcher.launch_record(script_type, name, desc)
            return True
        except Exception as e:
            logger.error(f"启动录制失败: {e}", exc_info=True)
            return False

    def stop(self) -> bool:
        if self.current_proc and self.current_proc.poll() is None:
            terminate(self.current_proc)
            self.current_proc = None
            return True
        return False

    def is_active(self) -> bool:
        return self.current_proc is not None and self.current_proc.poll() is None